{
  "name": "majestic-fleet-desktop",
  "version": "1.1.2",
  "description": "Локальный менеджер автопарка, аренды и сделок Majestic RP",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win nsis",
    "pack:portable": "electron-builder --win portable",
    "publish:win": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.majestic.fleetdesk",
    "productName": "Fleet Desk",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/**/*", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "publish": [{ "provider": "github", "owner": "bbfry656", "repo": "Fleet-Desk", "releaseType": "release" }]
  }
}
